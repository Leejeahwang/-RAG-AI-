# Copy to .env only if it does not already exist. Never commit API keys.
AI_PROVIDER=auto
GEMINI_API_KEY=
# Change this if your Gemini account requires a different model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Send the same zone context to Gemini and Ollama. Set false to keep layouts local.
GEMINI_SEND_LAYOUT=true
GEMINI_CONNECT_TIMEOUT=5
GEMINI_READ_TIMEOUT=15
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_RETRY_COOLDOWN=60
OLLAMA_EMERGENCY_TIMEOUT=15
OLLAMA_READ_TIMEOUT=30
LLM_MODEL=qwen2.5:0.5b
TTS_ENGINE=PPASO
# Gemini TTS is disabled by default; all answers use the local TTS_ENGINE.
GEMINI_TTS_ENABLED=false
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_READ_TIMEOUT=30
GEMINI_TTS_RETRY_COOLDOWN=60
# Omit STT_ENABLED to retain platform default: Windows true, Linux false.
# STT_ENABLED=false
STT_WHISPER_MODEL=small
STT_LOCAL_FILES_ONLY=true
SENSOR_MODE=demo
DEMO_VISION_ESCALATION=true
ZONE_ID=A
# Camera/sensor observation zone; omit to use ZONE_ID.
# DETECTION_ZONE_ID=A
# ZONE_ID is this device's installation/listener zone, not a remote fire origin.
# Opt in on each device after setting a shared LAN token and unique node id.
ALERT_HTTP_ENABLED=false
ALERT_HTTP_HOST=127.0.0.1
ALERT_HTTP_PORT=8765
ALERT_HTTP_TOKEN=
ALERT_NODE_ID=
# Comma-separated receiver URLs, e.g. http://192.168.45.12:8765
ALERT_HTTP_PEERS=
